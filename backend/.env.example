# Copy this file to backend/.env. Never put a Supabase secret/service-role key here.
APP_ENV=development
LOG_LEVEL=INFO

SUPABASE_URL=https://wnutabervhntqceselwf.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-sb_publishable-key
SUPABASE_JWKS_URL=https://wnutabervhntqceselwf.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SCHEMA=public

# JSON array or comma-separated origins. Never use * when credentials are enabled.
# In production, replace these and TRUSTED_HOSTS with the exact public origin/host.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
JWT_AUDIENCE=authenticated
JWT_ALGORITHM=ES256
JWKS_CACHE_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=10
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
DOCS_ENABLED=true
